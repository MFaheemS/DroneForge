<%- include('../partials/head', { title: 'Login — DroneForge' }) %>
<%- include('../partials/navbar') %>

<main>
  <div class="auth-wrapper">
    <div class="auth-card">

      <div class="auth-logo">DRONEFORGE</div>
      <h1 class="auth-title">Pilot Login</h1>
      <p class="auth-sub">Authenticate to Continue</p>

      <% if (query && query.reset === 'success') { %>
        <div class="alert alert-success">
          <span class="material-symbols-outlined" style="font-size:1rem;flex-shrink:0;">check_circle</span>
          Password reset successful. Log in with your new credentials.
        </div>
      <% } %>

      <% if (errors && errors.length) { %>
        <div class="alert alert-error">
          <span class="material-symbols-outlined" style="font-size:1rem;flex-shrink:0;">error</span>
          <div><% errors.forEach(e => { %><div><%= e.msg %></div><% }) %></div>
        </div>
      <% } %>

      <form action="/auth/login" method="POST" novalidate>
        <div class="form-group">
          <label class="form-label" for="email">Email Address</label>
          <input
            type="email" id="email" name="email"
            class="form-input"
            value="<%= old && old.email ? old.email : '' %>"
            placeholder="pilot@droneforge.io"
            autocomplete="email" required
          />
        </div>

        <div class="form-group">
          <label class="form-label" for="password" style="display:flex;justify-content:space-between;align-items:center;">
            Password
            <a href="/auth/forgot-password" style="font-size:.65rem;color:var(--muted);letter-spacing:.06em;text-transform:uppercase;font-weight:600;">Forgot?</a>
          </label>
          <div class="input-wrapper">
            <input
              type="password" id="password" name="password"
              class="form-input"
              placeholder="••••••••"
              autocomplete="current-password" required
            />
            <button type="button" class="input-toggle" aria-label="Toggle password visibility">
              <span class="material-symbols-outlined" style="font-size:1.1rem;font-variation-settings:'FILL' 0;">visibility</span>
            </button>
          </div>
        </div>

        <button type="submit" class="btn btn-primary btn-full" style="margin-top:.75rem;">
          <span class="material-symbols-outlined" style="font-size:1rem;">login</span>
          Authenticate
        </button>
      </form>

      <div class="auth-footer">
        No account? <a href="/auth/register" style="color:var(--cyan);font-weight:700;">Register Now</a>
      </div>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
<%- include('../partials/scripts') %>
