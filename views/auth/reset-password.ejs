<%- include('../partials/head', { title: 'New Password — DroneForge' }) %>
<%- include('../partials/navbar') %>

<main>
  <div class="auth-wrapper">
    <div class="auth-card">

      <div class="auth-logo">DRONEFORGE</div>
      <h1 class="auth-title">Set New Password</h1>
      <p class="auth-sub">Choose a Strong Password</p>

      <% if (errors && errors.length) { %>
        <div class="alert alert-error">
          <span class="material-symbols-outlined" style="font-size:1rem;flex-shrink:0;">error</span>
          <div><% errors.forEach(e => { %><div><%= e.msg %></div><% }) %></div>
        </div>
      <% } %>

      <% if (token) { %>
        <form action="/auth/reset-password/<%= token %>" method="POST" novalidate>
          <div class="form-group">
            <label class="form-label" for="password">New Password</label>
            <div class="input-wrapper">
              <input
                type="password" id="password" name="password"
                class="form-input"
                placeholder="Min. 8 characters"
                required minlength="8"
              />
              <button type="button" class="input-toggle" aria-label="Toggle">
                <span class="material-symbols-outlined" style="font-size:1.1rem;font-variation-settings:'FILL' 0;">visibility</span>
              </button>
            </div>
            <div class="password-strength"><div class="password-strength-bar"></div></div>
          </div>
          <div class="form-group">
            <label class="form-label" for="confirmPassword">Confirm Password</label>
            <div class="input-wrapper">
              <input
                type="password" id="confirmPassword" name="confirmPassword"
                class="form-input" placeholder="Repeat password" required
              />
              <button type="button" class="input-toggle" aria-label="Toggle">
                <span class="material-symbols-outlined" style="font-size:1.1rem;font-variation-settings:'FILL' 0;">visibility</span>
              </button>
            </div>
          </div>
          <button type="submit" class="btn btn-primary btn-full">
            <span class="material-symbols-outlined" style="font-size:1rem;">lock_reset</span>
            Update Password
          </button>
        </form>
      <% } else { %>
        <div class="alert alert-error">
          <span class="material-symbols-outlined" style="font-size:1rem;flex-shrink:0;">link_off</span>
          This reset link is invalid or has expired (15 min limit).
        </div>
        <a href="/auth/forgot-password" class="btn btn-outline btn-full" style="margin-top:.5rem;">Request New Link</a>
      <% } %>

      <div class="auth-footer">
        <a href="/auth/login" style="color:var(--muted);">← Back to Login</a>
      </div>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
<%- include('../partials/scripts') %>
