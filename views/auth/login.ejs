<%- include('../partials/head', { title: 'Login — DroneForge OS' }) %>

<div class="auth-page-wrap">

  <!-- Cinematic background -->
  <div class="auth-cinematic-bg">
    <img src="https://lh3.googleusercontent.com/aida/ADBb0ujcragCVjKsuTRhOU7Ugi7oA0-LnL4t_MhLNgahMWjsxTvUkvqWcZvPHzyUpRMe-iL2d2I3d87qBRUAqEaKgFx_V0HI03rVlgLcRcX2k9hYnfpb9BohvbN_zRhoRo1yMwXgt-Lgfja0oNqrGCitWaJ4uIlsJTaraqDDICA8TpPZTFtTtDaBZJmAvG07alnwM3-oaXy3j-0d6x-yA5DSXSMZ93C_rGG6zCxfqWj8K0oFlVazOZ00ScaWDEQ" alt="" aria-hidden="true" />
    <div class="auth-cinematic-bg-fade"></div>
    <div class="auth-cinematic-bg-mesh"></div>
  </div>

  <!-- HUD corners -->
  <div class="hud-corner hud-corner-tl"></div>
  <div class="hud-corner hud-corner-tr"></div>
  <div class="hud-corner hud-corner-bl"></div>
  <div class="hud-corner hud-corner-br"></div>

  <!-- Standalone header -->
  <header class="auth-standalone-header">
    <a href="/" class="auth-brand-mark">DroneForge</a>
    <div class="auth-sys-status">
      System Status: Secure
      <div class="auth-sys-dot"></div>
    </div>
  </header>

  <!-- Main form area -->
  <main class="auth-main-area">
    <div class="auth-card-stitch">

      <!-- Header -->
      <div style="text-align:center;margin-bottom:2rem;">
        <h1 style="font-family:var(--font-headline);font-size:1.4rem;font-weight:900;color:var(--text);text-transform:uppercase;letter-spacing:.05em;margin-bottom:.35rem;">Authorization</h1>
        <p style="font-family:var(--font-mono);font-size:.8rem;color:var(--muted);letter-spacing:.04em;">Initialize clandestine flight protocols.</p>
      </div>

      <% if (query && query.reset === 'success') { %>
        <div class="alert alert-success">
          <span class="material-symbols-outlined" style="font-size:1rem;flex-shrink:0;">check_circle</span>
          Password reset successful. Log in with your new credentials.
        </div>
      <% } %>

      <% if (errors && errors.length) { %>
        <div class="alert alert-error">
          <span class="material-symbols-outlined" style="font-size:1rem;flex-shrink:0;">error</span>
          <div><% errors.forEach(e => { %><div><%= e.msg %></div><% }) %></div>
        </div>
      <% } %>

      <form action="/auth/login" method="POST" novalidate>

        <!-- Email -->
        <div class="si-group">
          <label class="si-label" for="email">
            <span class="material-symbols-outlined">alternate_email</span>
            Operator ID / Email
          </label>
          <div class="si-wrap">
            <span class="material-symbols-outlined si-icon">alternate_email</span>
            <input
              type="email" id="email" name="email"
              value="<%= old && old.email ? old.email : '' %>"
              placeholder="OPERATOR@DRONEFORGE.OPS"
              autocomplete="email" required
            />
            <div class="si-bar"></div>
          </div>
        </div>

        <!-- Password -->
        <div class="si-group">
          <div class="si-label-row">
            <label class="si-label" for="password">
              <span class="material-symbols-outlined">lock</span>
              Security Cipher
            </label>
            <a href="/auth/forgot-password" class="si-forgot">Recover Cipher</a>
          </div>
          <div class="si-wrap">
            <span class="material-symbols-outlined si-icon">lock</span>
            <input
              type="password" id="password" name="password"
              placeholder="••••••••••••"
              autocomplete="current-password" required
            />
            <button type="button" class="si-toggle" aria-label="Toggle visibility">
              <span class="material-symbols-outlined" style="font-size:1.1rem;font-variation-settings:'FILL' 0;">visibility</span>
            </button>
            <div class="si-bar"></div>
          </div>
        </div>

        <!-- Remember Me -->
        <div style="display:flex;align-items:center;gap:.6rem;margin-bottom:1.25rem;">
          <input type="checkbox" id="rememberMe" name="rememberMe" value="1"
            style="width:15px;height:15px;accent-color:var(--cyan);cursor:pointer;flex-shrink:0;" />
          <label for="rememberMe"
            style="font-family:var(--font-label);font-size:.75rem;font-weight:600;color:var(--muted);letter-spacing:.05em;cursor:pointer;user-select:none;">
            Remember me for 30 days
          </label>
        </div>

        <button type="submit" class="auth-btn-stitch">
          <span class="material-symbols-outlined" style="font-size:1rem;">login</span>
          Access Command Center
        </button>
      </form>

      <!-- Quick-fill test credentials -->
      <div class="demo-creds-section">
        <p class="demo-creds-label">
          <span class="material-symbols-outlined" style="font-size:.75rem;vertical-align:middle;">bolt</span>
          Demo Access
        </p>
        <div class="demo-creds-row">
          <button type="button" class="demo-cred-btn" onclick="fillCreds('admin@droneforge.io','Admin@1234')">
            <span class="material-symbols-outlined" style="font-size:.9rem;color:var(--orange);">shield</span>
            <span>
              <span style="display:block;font-size:.75rem;font-weight:600;color:var(--text);">Admin Account</span>
              <span style="display:block;font-size:.65rem;color:var(--muted);font-family:var(--font-mono);">admin@droneforge.io</span>
            </span>
          </button>
          <button type="button" class="demo-cred-btn" onclick="fillCreds('pilot@droneforge.io','Pilot@1234')">
            <span class="material-symbols-outlined" style="font-size:.9rem;color:var(--cyan);">flight_takeoff</span>
            <span>
              <span style="display:block;font-size:.75rem;font-weight:600;color:var(--text);">Customer Account</span>
              <span style="display:block;font-size:.65rem;color:var(--muted);font-family:var(--font-mono);">pilot@droneforge.io</span>
            </span>
          </button>
        </div>
      </div>

      <hr class="auth-divider" />
      <div class="auth-footer-link">
        No account? <a href="/auth/register">Request Clearance</a>
      </div>

    </div>
  </main>

  <!-- Status bar -->
  <div class="auth-status-bar">
    <div class="auth-status-item">
      <div class="ast-dot-green"></div>
      Global Uplink: Active
    </div>
    <div class="auth-status-item">
      <div class="ast-dot-gray"></div>
      Lat: 40.7128° N
    </div>
    <div class="auth-status-item">
      <div class="ast-dot-gray"></div>
      AES-256 Encrypted
    </div>
  </div>

</div>

<%- include('../partials/scripts') %>
<script>
  function fillCreds(email, password) {
    const emailEl = document.getElementById('email');
    emailEl.value = email;
    emailEl.style.transition = 'box-shadow .2s';
    emailEl.style.boxShadow = '0 0 0 2px rgba(180,79,255,.4)';
    setTimeout(() => { emailEl.style.boxShadow = ''; }, 600);
  }

  document.querySelectorAll('.si-toggle').forEach(btn => {
    btn.addEventListener('click', () => {
      const input = btn.closest('.si-wrap').querySelector('input');
      const icon  = btn.querySelector('.material-symbols-outlined');
      if (input.type === 'password') { input.type = 'text'; icon.textContent = 'visibility_off'; }
      else { input.type = 'password'; icon.textContent = 'visibility'; }
    });
  });
</script>
