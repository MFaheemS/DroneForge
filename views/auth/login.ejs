<%- include('../partials/head', { title: 'Login — DroneForge' }) %>
<%- include('../partials/navbar') %>

<main>
  <div class="auth-wrapper">
    <div class="auth-card">
      <div class="auth-logo">🚁 DroneForge</div>
      <h1 class="auth-title">Welcome back, Pilot</h1>
      <p class="auth-sub">Log in to continue building.</p>

      <% if (query && query.reset === 'success') { %>
        <div class="alert alert-success">✅ Password reset successful. Log in with your new password.</div>
      <% } %>

      <% if (errors && errors.length) { %>
        <div class="alert alert-error">
          <span>⚠</span>
          <div>
            <% errors.forEach(e => { %><div><%= e.msg %></div><% }) %>
          </div>
        </div>
      <% } %>

      <form action="/auth/login" method="POST" novalidate>
        <div class="form-group">
          <label class="form-label" for="email">Email Address</label>
          <input
            type="email"
            id="email"
            name="email"
            class="form-input"
            value="<%= old && old.email ? old.email : '' %>"
            placeholder="pilot@droneforge.io"
            autocomplete="email"
            required
          />
        </div>

        <div class="form-group">
          <label class="form-label" for="password">Password</label>
          <div class="input-wrapper">
            <input
              type="password"
              id="password"
              name="password"
              class="form-input"
              placeholder="••••••••"
              autocomplete="current-password"
              required
            />
            <button type="button" class="input-toggle" aria-label="Toggle password visibility">👁</button>
          </div>
        </div>

        <div style="text-align:right;margin-bottom:1.25rem;">
          <a href="/auth/forgot-password" style="font-size:0.8rem;color:var(--text-muted);">Forgot password?</a>
        </div>

        <button type="submit" class="btn btn-primary btn-full">Login →</button>
      </form>

      <div class="auth-footer">
        Don't have an account? <a href="/auth/register">Create one</a>
      </div>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
<%- include('../partials/scripts') %>
