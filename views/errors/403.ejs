<%- include('../partials/head', { title: '403 — Access Denied | DroneForge' }) %>

<div class="error-cinematic-wrap">

  <!-- Cinematic BG -->
  <div class="error-cin-bg" style="background-image:url('https://lh3.googleusercontent.com/aida/ADBb0uiquZ-tThBP5rKXPxqG3GmjujSv_IQqaFkaz_7_UY2hS8kt-UygvWquUMaPd-urKbNkSAaThab1CIDe9_BwBWZ07SYpkvZzrAr6y3RmD-3KBwjxOVh7dqznIRlKwNqZVV8RIQxLpaABC3FGNC0pk34PrxALK6LKSKuxpizgIjmxa3dTEO_5xS4OR_L1UACvlgR5YoboOpnVSBydFq_EWEPPNk9g9vCx6SmvSg5-GDy8iUJ6qoqVruP29II');"></div>
  <div class="error-cin-vignette"></div>
  <div class="scanlines"></div>

  <!-- HUD text overlays -->
  <div class="error-hud error-hud-tl">
    <div>SYS.STAT // RESTRICTED</div>
    <div>CLEARANCE: DENIED</div>
    <div>ACCESS: REVOKED</div>
  </div>
  <div class="error-hud error-hud-tr">
    <div>DRONEFORGE CMD</div>
    <div>AUTH_FAIL</div>
  </div>
  <div class="error-hud error-hud-bl glitch">
    <span class="material-symbols-outlined" style="font-size:.85rem;vertical-align:middle;">gpp_bad</span>
    ERR_403_FORBIDDEN
  </div>
  <div class="error-hud error-hud-br">IP: LOGGED</div>

  <!-- Crosshair -->
  <div class="error-crosshair" aria-hidden="true">
    <div class="error-crosshair-ring">
      <div class="ecr-h"></div>
      <div class="ecr-v"></div>
    </div>
  </div>

  <!-- Main panel -->
  <main class="error-cin-panel">
    <div class="error-icon-ring">
      <span class="material-symbols-outlined">gpp_bad</span>
      <svg viewBox="0 0 100 100" fill="none">
        <circle cx="50" cy="50" r="48" stroke="currentColor" stroke-dasharray="10 5" stroke-width="1"/>
      </svg>
    </div>

    <h1 class="error-cin-title" style="color:var(--error);">Access Denied</h1>
    <p class="error-cin-sub">
      You don't have clearance to enter this restricted zone. Admin credentials required. Unauthorized access attempts are logged and monitored.
    </p>

    <div style="display:flex;gap:1rem;justify-content:center;flex-wrap:wrap;">
      <a href="/" class="error-cin-btn" style="background:var(--error);color:#fff;">
        <span class="material-symbols-outlined" style="font-size:1rem;">arrow_back</span>
        Return to Safety
      </a>
      <% if (!user) { %>
        <a href="/auth/login" class="btn btn-outline btn-sm">Log In</a>
      <% } %>
    </div>

    <p style="font-family:var(--font-mono);font-size:.62rem;color:var(--error);margin-top:2rem;opacity:.5;letter-spacing:.06em;animation:glitchAnim 2s step-end infinite;">
      UNAUTHORIZED ACCESS ATTEMPT LOGGED @ <%= new Date().toISOString() %>
    </p>
  </main>

</div>

<%- include('../partials/scripts') %>
