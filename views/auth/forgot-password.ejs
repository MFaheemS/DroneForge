<%- include('../partials/head', { title: 'Forgot Password — DroneForge' }) %>
<%- include('../partials/navbar') %>

<main>
  <div class="auth-wrapper">
    <div class="auth-card">

      <div class="auth-logo">DRONEFORGE</div>
      <h1 class="auth-title">Forgot Password</h1>
      <p class="auth-sub">Enter Email to Receive Reset Link</p>

      <% if (errors && errors.length) { %>
        <div class="alert alert-error">
          <span class="material-symbols-outlined" style="font-size:1rem;flex-shrink:0;">error</span>
          <div><% errors.forEach(e => { %><div><%= e.msg %></div><% }) %></div>
        </div>
      <% } %>

      <% if (success) { %>
        <div class="alert alert-success">
          <span class="material-symbols-outlined" style="font-size:1rem;flex-shrink:0;">mark_email_read</span>
          <%= success %>
        </div>
      <% } %>

      <form action="/auth/forgot-password" method="POST" novalidate>
        <div class="form-group">
          <label class="form-label" for="email">Email Address</label>
          <input
            type="email" id="email" name="email"
            class="form-input"
            placeholder="pilot@droneforge.io"
            autocomplete="email" required
          />
        </div>
        <button type="submit" class="btn btn-primary btn-full">
          <span class="material-symbols-outlined" style="font-size:1rem;">send</span>
          Send Reset Link
        </button>
      </form>

      <div class="auth-footer">
        <a href="/auth/login" style="color:var(--muted);">← Back to Login</a>
      </div>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
<%- include('../partials/scripts') %>
