<%- include('partials/head', { title: 'DroneForge — Build. Fly. Dominate the Sky.' }) %>
<%- include('partials/navbar') %>

<main>

  <!-- ── HERO ── -->
  <section class="hero">
    <!-- Background image -->
    <img
      class="hero-bg-img"
      src="https://lh3.googleusercontent.com/aida-public/AB6AXuDPlhLP2lVC5f3KQ9mfYG2wHdDT45PCbiVdSlr65xm1w6Sly2rfSqiTZd0bNkm_RAoQMg0gyGRGKcIrIz_tZzY3ka7etqyCfzCTUHXWq7ymvC_C6Tw1H96OLkRF4Km9Wzw8a0_jlebZR1n89m1lknYx2afzsGUHqRcQTGun14EtDn1vlLj6JYd6o77UXl6mPZYXB3ffm8vQcdW_oKbSwUa9DBk9mbmbI8T-rFsipSgjyXodQ2MT_Sg8xmu-rUpiUhlBJpr_B6AUr0s"
      alt="DroneForge futuristic drone in hangar"
    />
    <div class="hero-bg-fade"></div>
    <div class="hero-shimmer"></div>

    <div class="hero-content">
      <p class="hero-eyebrow">Next-Gen Drone Builder Platform</p>

      <h1 class="hero-h1">
        Build. Fly.<br/>
        <span class="accent">Dominate the Sky.</span>
      </h1>

      <p class="hero-sub">
        Engineered for precision. Designed for dominance. Experience the pinnacle of aerospace technology with modular drone systems built for extreme performance.
      </p>

      <div class="hero-actions">
        <a href="<%= user ? '/build' : '/auth/register' %>" class="btn btn-primary btn-lg">
          <span class="material-symbols-outlined" style="font-size:1rem;">rocket_launch</span>
          Configure Now
        </a>
        <a href="/parts" class="btn btn-outline btn-lg">
          Browse Parts
        </a>
      </div>

      <% if (user) { %>
        <div style="margin-top:2rem;">
          <span class="status-pill online">System Online</span>
          <span style="font-family:var(--font-label);font-size:.65rem;font-weight:600;color:var(--muted);margin-left:.75rem;letter-spacing:.1em;text-transform:uppercase;">
            Pilot: <%= user.name.toUpperCase() %>
          </span>
        </div>
      <% } %>
    </div>

    <div class="hero-scroll">
      <div class="scroll-line"></div>
      <span>Scroll</span>
    </div>
  </section>

  <!-- ── STATS ── -->
  <div class="stats-bar">
    <div class="stats-grid">
      <div>
        <span class="stat-value" data-target="4200" data-suffix="+">0</span>
        <span class="stat-label">Drones Built</span>
      </div>
      <div>
        <span class="stat-value" data-target="120" data-suffix="+">0</span>
        <span class="stat-label">Parts in Catalog</span>
      </div>
      <div>
        <span class="stat-value" data-target="3800" data-suffix="+">0</span>
        <span class="stat-label">Active Pilots</span>
      </div>
      <div>
        <span class="stat-value" data-target="99" data-suffix="%">0</span>
        <span class="stat-label">Satisfaction</span>
      </div>
    </div>
  </div>

  <!-- ── MACRO DETAIL GRID (Stitch) ── -->
  <section class="macro-detail-section">
    <div class="container">
      <div class="macro-detail-grid">
        <div class="macro-card">
          <img
            src="https://lh3.googleusercontent.com/aida-public/AB6AXuAZIEAsAvY_l7aIR3g3TS1tymPXusSVkCI2M_HqKtVsxr3lz38JdmoKW1I3ERYMInxbj4wjpTuWebj3t2Cl0tNeu5C3OrCTcaAgS_j19UWasBCDtR3vrb0tjDMiZ5V7HrAubxF3YJhGQauKrlaBYUakwi7RlzeMIdKUhHpMEW2NqDY56m1u79AK3X2FeuntBGIdO8myBlfB03FT9hIpLlF0eJzYknNHZgjeT8H0i0AiB_PmZUd309bVNq_1TM-0HT7FbYzskJgAc60"
            alt="Carbon fiber macro"
            loading="lazy"
          />
          <div class="macro-card-label">
            <p class="macro-card-eyebrow" style="color:var(--cyan);">Aerospace Grade</p>
            <p class="macro-card-title">Unidirectional Carbon</p>
          </div>
        </div>
        <div class="macro-card">
          <img
            src="https://lh3.googleusercontent.com/aida-public/AB6AXuBc2cr7tNNG-pCXUm8IwUwOz2uFetCCEsVLatZ4BG-N5S4WbOVivPAaTJ2qBld9J2XbnH0wQd3wDspt1N8a1EhotNxzGfUcVcjchsCOdILORNDBPpsb8GI9hb57sGtuzzjikkQ4th8lu7lH5LLaapgsaJp_XhddrlFD4dZrehthNYgkdy5xZQsiJl0pRzmcJR4HUkwtnhcpzKlaXbzo1nQpCn2Y7Hwt_qm9UmLaIOczsQKqbF7Uc8a_duq5KDDrC7h4FyIPvXm4h34"
            alt="Precision optics macro"
            loading="lazy"
          />
          <div class="macro-card-label">
            <p class="macro-card-eyebrow" style="color:var(--orange);">Precision Optics</p>
            <p class="macro-card-title">8K Spectral Sensor</p>
          </div>
        </div>
        <div class="macro-card">
          <img
            src="https://lh3.googleusercontent.com/aida-public/AB6AXuDf5luXOH2gwZgITPhf1iXV6eSrsTu_q9-bYAV6Z91xVioKgMl7KLdIMpwCnjbpWvIM-yJ8HmWsdSKNjGZLE611MQnDk0NceA1DwMzZrPtrQoZ6-VQ3xpl25YsUNYJpRt_7tw6tyiJlyujf7bdEr_JHF5xHaPmHL9GayF0JTWGOJTqOFh9SJR1000h227any_DBptSxdhE-2bgMDxrN2jFv3zLk-cRHeGdvNzkvLXO68Mvp9iC_GdzbhQJlPoZoizApnfshiklZMiU"
            alt="Brushless motor macro"
            loading="lazy"
          />
          <div class="macro-card-label">
            <p class="macro-card-eyebrow" style="color:var(--green);">High Torque</p>
            <p class="macro-card-title">Forge-X Propulsion</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── SYSTEM CAPABILITIES (Bento Grid) ── -->
  <section class="section">
    <div class="container">
      <p class="section-label reveal">System Capabilities</p>
      <h2 class="section-title reveal">
        What DroneForge <span style="color:var(--cyan)">Delivers</span>
        <span class="cyan-bar"></span>
      </h2>

      <div class="bento reveal" style="margin-top:2.5rem;">
        <!-- Large: Neural Autonomy -->
        <div class="bento-item bento-col-8 bento-row-2" style="padding:0;overflow:hidden;display:flex;flex-direction:column;justify-content:flex-end;">
          <div style="position:absolute;inset:0;background:linear-gradient(135deg,rgba(0,242,255,0.04),transparent 60%)"></div>
          <div style="position:absolute;top:0;right:0;bottom:0;left:0;background:url('https://lh3.googleusercontent.com/aida-public/AB6AXuBKFw9ERsWtFKMSOloZZGKhgU3FMXUsghYfc0TYbNBlpTquTZbYuMZ1BSpeHVPaeJyez7W9XZtSR4hYztPjek4aGhjaWkHMebkp10MBx68OOIsEtQ_QUvGYerMXqeYWqGNXlvhsa4Eia6bN2TrDDIiFC_sGY4hs2pQYU7bTU2Fi8XnMKNKwRN6xfsK_Vbhdd_kI_q_ZZDyT8rxMNe8E8HysRXVcSW3ndFd3CkEsEuk6_ranmyFxyZKgigpkj6NOQP5RZ38gF_wWj0M') center/cover no-repeat;opacity:.18;transition:opacity .4s;"></div>
          <div class="bento-item" style="position:absolute;bottom:0;left:0;right:0;padding:2rem;background:linear-gradient(to top, rgba(25,33,34,0.95) 60%, transparent);border:none;border-radius:0;backdrop-filter:none;">
            <div style="display:flex;align-items:center;gap:.75rem;margin-bottom:.75rem;">
              <span class="material-symbols-outlined" style="color:var(--cyan);font-variation-settings:'FILL' 1;">psychology</span>
              <h3 style="font-family:var(--font-headline);font-size:1.4rem;font-weight:700;color:var(--text);letter-spacing:-0.01em;">Neural Autonomy Core</h3>
            </div>
            <p style="color:var(--text-variant);font-size:.9rem;line-height:1.7;max-width:480px;">
              Self-learning flight algorithms adapt to atmospheric conditions in real-time, executing complex flight paths with zero manual input required.
            </p>
          </div>
        </div>

        <!-- 8K Optics -->
        <div class="bento-item bento-col-4" style="display:flex;flex-direction:column;justify-content:flex-end;background:linear-gradient(135deg,rgba(255,138,0,0.06),var(--glass-bg));">
          <span class="material-symbols-outlined" style="color:var(--orange);font-size:2.5rem;font-variation-settings:'FILL' 1;margin-bottom:1rem;">camera</span>
          <h3 style="font-family:var(--font-headline);font-size:1.2rem;font-weight:700;color:var(--text);margin-bottom:.5rem;letter-spacing:-0.01em;">8K Optics</h3>
          <p style="color:var(--text-variant);font-size:.875rem;line-height:1.65;">Cinematic-grade sensor stabilization with hyper-spectral imaging capabilities.</p>
        </div>

        <!-- Omni-Radar -->
        <div class="bento-item bento-col-4" style="background:linear-gradient(135deg,rgba(0,255,65,0.04),var(--glass-bg));">
          <div style="position:absolute;top:1.5rem;right:1.5rem;width:52px;height:52px;border-radius:50%;border:1px solid rgba(0,255,65,0.4);display:flex;align-items:center;justify-content:center;">
            <div style="width:38px;height:38px;border-radius:50%;border:1px solid rgba(0,255,65,0.6);display:flex;align-items:center;justify-content:center;animation:pingGreen 1.5s infinite;">
              <div style="width:8px;height:8px;border-radius:50%;background:var(--green);"></div>
            </div>
          </div>
          <div style="position:absolute;bottom:2rem;left:2rem;">
            <span class="material-symbols-outlined" style="color:var(--green);font-variation-settings:'FILL' 1;margin-bottom:.5rem;display:block;">radar</span>
            <h3 style="font-family:var(--font-headline);font-size:1.2rem;font-weight:700;color:var(--text);margin-bottom:.5rem;letter-spacing:-0.01em;">Omni-Radar</h3>
            <p style="color:var(--text-variant);font-size:.875rem;line-height:1.65;">360° LiDAR spatial mapping prevents collisions at high speeds.</p>
          </div>
        </div>

        <!-- Hot-Swap Architecture -->
        <div class="bento-item bento-col-8" style="display:flex;align-items:center;gap:2.5rem;">
          <div style="flex:1;border-right:1px solid var(--glass-border);padding-right:2.5rem;">
            <span class="material-symbols-outlined" style="color:var(--cyan);font-size:2.5rem;font-variation-settings:'FILL' 1;margin-bottom:1rem;display:block;">precision_manufacturing</span>
            <h3 style="font-family:var(--font-headline);font-size:1.2rem;font-weight:700;color:var(--text);margin-bottom:.75rem;letter-spacing:-0.01em;">Hot-Swap Architecture</h3>
            <p style="color:var(--text-variant);font-size:.875rem;line-height:1.7;">
              Interchangeable payload bays allow rapid deployment of specialized equipment. Swap sensors, batteries, or propulsion modules in under 60 seconds.
            </p>
          </div>
          <div style="flex:1;display:flex;flex-direction:column;gap:.6rem;">
            <div class="hud-row">
              <span class="hud-row-label">PWR-CELL-X</span>
              <span class="hud-row-status online">Online</span>
            </div>
            <div class="hud-row">
              <span class="hud-row-label">Thermal-Optic</span>
              <span class="hud-row-status online">Online</span>
            </div>
            <div class="hud-row" style="opacity:.5;">
              <span class="hud-row-label">Heavy-Lift-Mod</span>
              <span class="hud-row-status offline">Offline</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── HOW IT WORKS ── -->
  <section class="section-sm" style="background:rgba(21,29,30,0.6);border-top:1px solid var(--glass-border);border-bottom:1px solid var(--glass-border);">
    <div class="container">
      <p class="section-label reveal">Mission Briefing</p>
      <h2 class="section-title reveal">
        Three Steps to <span style="color:var(--cyan)">Liftoff</span>
        <span class="cyan-bar"></span>
      </h2>

      <div class="grid-3" style="margin-top:2.5rem;">
        <div class="step-card reveal">
          <span class="step-number">01</span>
          <div class="step-icon">
            <span class="material-symbols-outlined" style="color:var(--cyan);font-size:1.25rem;font-variation-settings:'FILL' 0;">grid_view</span>
          </div>
          <div class="step-title">Pick Your Parts</div>
          <p class="step-desc">Browse 120+ motors, frames, batteries, cameras, and controllers. Filter by category, price range, and weight limits.</p>
        </div>

        <div class="step-card reveal" style="transition-delay:.1s">
          <span class="step-number">02</span>
          <div class="step-icon">
            <span class="material-symbols-outlined" style="color:var(--cyan);font-size:1.25rem;font-variation-settings:'FILL' 0;">settings</span>
          </div>
          <div class="step-title">Build Your Drone</div>
          <p class="step-desc">Slot parts into our visual builder. Get real-time compatibility checks, weight calculations, and flight time estimates.</p>
        </div>

        <div class="step-card reveal" style="transition-delay:.2s">
          <span class="step-number">03</span>
          <div class="step-icon">
            <span class="material-symbols-outlined" style="color:var(--cyan);font-size:1.25rem;font-variation-settings:'FILL' 0;">send</span>
          </div>
          <div class="step-title">Order & Fly</div>
          <p class="step-desc">Checkout securely, track your build through shipping, and get your custom machine delivered — ready to fly.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── CTA ── -->
  <section class="section" style="text-align:center;position:relative;overflow:hidden;">
    <div style="position:absolute;inset:0;background:radial-gradient(ellipse at center,rgba(0,242,255,0.04) 0%,transparent 65%);pointer-events:none;"></div>
    <div class="container" style="position:relative;z-index:1;">
      <p class="section-label reveal" style="justify-content:center;">Launch Sequence</p>
      <h2 class="section-title reveal" style="max-width:600px;margin-left:auto;margin-right:auto;">
        Ready to build your <span style="color:var(--cyan)">custom drone?</span>
        <span class="cyan-bar" style="margin-left:auto;margin-right:auto;"></span>
      </h2>
      <p class="reveal" style="color:var(--text-variant);font-size:.95rem;margin:1.5rem auto 2.5rem;max-width:480px;line-height:1.8;">
        Join 4,200+ pilots who've already taken flight with DroneForge. Your perfect build is waiting.
      </p>
      <div class="hero-actions reveal">
        <a href="<%= user ? '/build' : '/auth/register' %>" class="btn btn-primary btn-lg">
          <span class="material-symbols-outlined" style="font-size:1rem;">rocket_launch</span>
          Get Started Free
        </a>
        <a href="/parts" class="btn btn-outline btn-lg">Explore Parts</a>
      </div>
    </div>
  </section>

</main>

<%- include('partials/footer') %>
<%- include('partials/scripts') %>
