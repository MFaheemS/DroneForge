<%- include('../partials/head', { title: 'Forgot Password — DroneForge' }) %>
<%- include('../partials/navbar') %>

<main>
  <div class="auth-wrapper">
    <div class="auth-card">
      <div class="auth-logo">🚁 DroneForge</div>
      <h1 class="auth-title">Reset Password</h1>
      <p class="auth-sub">Enter your email and we'll send a reset link.</p>

      <% if (errors && errors.length) { %>
        <div class="alert alert-error">
          <span>⚠</span>
          <div><% errors.forEach(e => { %><div><%= e.msg %></div><% }) %></div>
        </div>
      <% } %>

      <% if (success) { %>
        <div class="alert alert-success">✅ <%= success %></div>
      <% } %>

      <form action="/auth/forgot-password" method="POST" novalidate>
        <div class="form-group">
          <label class="form-label" for="email">Email Address</label>
          <input
            type="email"
            id="email"
            name="email"
            class="form-input"
            placeholder="pilot@droneforge.io"
            autocomplete="email"
            required
          />
        </div>
        <button type="submit" class="btn btn-primary btn-full">Send Reset Link →</button>
      </form>

      <div class="auth-footer">
        <a href="/auth/login">← Back to Login</a>
      </div>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
<%- include('../partials/scripts') %>
