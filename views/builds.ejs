<%- include('partials/head', { title: title }) %>
<%- include('partials/navbar') %>

<style>
  /* ── Fleet page base ── */
  .fleet-page {
    min-height: 100vh;
    background: var(--surface-lowest);
    position: relative;
    overflow-x: hidden;
  }

  /* Ambient grid background */
  .fleet-grid-bg {
    position: fixed; inset: 0; z-index: 0; pointer-events: none;
    background-image:
      linear-gradient(rgba(180,79,255,0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(180,79,255,0.035) 1px, transparent 1px);
    background-size: 48px 48px;
  }
  /* Radial bloom top-center */
  .fleet-bloom {
    position: fixed; top: -200px; left: 50%; transform: translateX(-50%);
    width: 900px; height: 600px; border-radius: 50%; pointer-events: none; z-index: 0;
    background: radial-gradient(ellipse at center, rgba(180,79,255,0.08) 0%, transparent 70%);
  }

  .fleet-shell {
    position: relative; z-index: 1;
    max-width: 1380px; margin: 0 auto;
    padding: 3rem 2rem 5rem;
  }

  /* ── Header ── */
  .fleet-header { margin-bottom: 3.5rem; }
  .fleet-eyebrow {
    display: flex; align-items: center; gap: .55rem; margin-bottom: .9rem;
  }
  .fleet-pulse-dot {
    width: 8px; height: 8px; border-radius: 50%;
    background: var(--cyan);
    box-shadow: 0 0 14px var(--cyan), 0 0 30px rgba(180,79,255,.3);
    animation: fleetPulse 2.4s ease-in-out infinite;
    flex-shrink: 0;
  }
  @keyframes fleetPulse { 0%,100%{opacity:1;transform:scale(1)} 50%{opacity:.5;transform:scale(.85)} }
  .fleet-eyebrow-label {
    font-family: var(--font-label); font-size: .62rem; font-weight: 700;
    letter-spacing: .28em; text-transform: uppercase; color: var(--cyan);
  }
  .fleet-title {
    font-family: var(--font-headline); font-size: clamp(2.2rem,5vw,3.4rem);
    font-weight: 700; color: #fff; text-transform: uppercase;
    letter-spacing: -.02em; line-height: 1.05; margin-bottom: .75rem;
  }
  .fleet-subtitle {
    color: var(--text-variant); font-size: 1rem; max-width: 560px; line-height: 1.65;
  }

  /* ── Bento grid ── */
  .fleet-bento {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 1.25rem;
  }

  /* ── Glass card base ── */
  .fleet-card {
    position: relative; overflow: hidden;
    background: rgba(16,12,24,0.6);
    backdrop-filter: blur(24px);
    border: 1px solid rgba(255,255,255,0.06);
    border-radius: 6px;
    transition: border-color .4s, box-shadow .4s, transform .35s;
    cursor: pointer;
  }
  .fleet-card:hover {
    border-color: rgba(180,79,255,.32);
    box-shadow: 0 0 60px rgba(180,79,255,.12), 0 20px 60px rgba(0,0,0,.4);
    transform: translateY(-2px);
  }

  /* Image fill */
  .fleet-card-img {
    width: 100%; height: 100%; object-fit: cover;
    transition: transform 1.1s cubic-bezier(.25,.46,.45,.94), filter .5s;
    filter: brightness(.85) saturate(.9);
  }
  .fleet-card:hover .fleet-card-img {
    transform: scale(1.06);
    filter: brightness(1) saturate(1.1);
  }

  /* Gradient overlays */
  .fleet-overlay-full {
    position: absolute; inset: 0;
    background: linear-gradient(to top, rgba(10,8,16,.95) 0%, rgba(10,8,16,.35) 45%, transparent 100%);
    z-index: 1;
  }
  .fleet-overlay-side {
    position: absolute; inset: 0;
    background: linear-gradient(to top, rgba(10,8,16,.92) 0%, rgba(10,8,16,.2) 55%, transparent 100%);
    z-index: 1;
  }
  .fleet-overlay-card {
    position: absolute; inset: 0;
    background: linear-gradient(to top, rgba(10,8,16,.96) 0%, rgba(10,8,16,.1) 50%, transparent 100%);
    z-index: 1;
  }

  /* Content positioning */
  .fleet-card-body {
    position: absolute; bottom: 0; left: 0; right: 0;
    padding: 2rem 2rem 1.75rem;
    z-index: 2;
  }
  .fleet-card-body-sm {
    position: absolute; bottom: 0; left: 0; right: 0;
    padding: 1.5rem 1.5rem 1.35rem;
    z-index: 2;
  }

  /* Badge top-right */
  .fleet-badge {
    position: absolute; top: 1rem; right: 1rem; z-index: 3;
    padding: .2rem .65rem;
    background: var(--cyan); color: #fff;
    font-family: var(--font-label); font-size: .55rem; font-weight: 800;
    letter-spacing: .12em; text-transform: uppercase;
    border-radius: 20px;
    box-shadow: 0 0 18px rgba(180,79,255,.5);
    font-style: italic;
  }

  /* Category / tier label */
  .fleet-tier {
    font-family: var(--font-mono); font-size: .6rem; font-weight: 500;
    letter-spacing: .35em; text-transform: uppercase;
    color: var(--cyan); margin-bottom: .4rem; display: block;
  }

  /* Build name */
  .fleet-name {
    font-family: var(--font-headline); text-transform: uppercase;
    color: #fff; line-height: 1.05; margin-bottom: .7rem;
    letter-spacing: -.01em;
  }
  .fleet-name-lg { font-size: clamp(1.5rem,3vw,2.1rem); }
  .fleet-name-md { font-size: 1.3rem; }
  .fleet-name-sm { font-size: 1.05rem; }

  /* Spec chips */
  .fleet-specs {
    display: flex; flex-wrap: wrap; gap: .35rem; margin-bottom: .9rem;
  }
  .fleet-spec-chip {
    padding: .2rem .55rem;
    background: rgba(180,79,255,.1); border: 1px solid rgba(180,79,255,.25);
    border-radius: 20px;
    font-family: var(--font-label); font-size: .55rem; font-weight: 700;
    letter-spacing: .08em; text-transform: uppercase; color: rgba(180,79,255,.9);
  }

  /* Stats row */
  .fleet-stats {
    display: flex; align-items: center; gap: 1.25rem;
    margin-bottom: 1.1rem;
  }
  .fleet-price {
    font-family: var(--font-mono); font-size: 1.2rem; font-weight: 700;
    color: var(--cyan);
  }
  .fleet-price-sm { font-size: 1rem; }
  .fleet-orders {
    display: flex; align-items: center; gap: .3rem;
    font-family: var(--font-label); font-size: .58rem; font-weight: 700;
    letter-spacing: .1em; text-transform: uppercase;
    color: rgba(255,255,255,.35);
  }
  .fleet-orders .material-symbols-outlined { font-size: .8rem; color: rgba(255,138,0,.7); }

  /* Action buttons */
  .fleet-actions { display: flex; gap: .6rem; }
  .fleet-actions-col { display: flex; flex-direction: column; gap: .5rem; }

  .fleet-btn-ghost {
    flex: 1; padding: .7rem 1.2rem;
    border: 1px solid rgba(180,79,255,.35); border-radius: 3px;
    background: rgba(180,79,255,.06);
    color: var(--cyan); font-family: var(--font-label); font-size: .62rem;
    font-weight: 700; letter-spacing: .15em; text-transform: uppercase;
    cursor: pointer; transition: background .2s, border-color .2s, box-shadow .2s;
    text-align: center; text-decoration: none; display: flex;
    align-items: center; justify-content: center; gap: .4rem;
  }
  .fleet-btn-ghost:hover {
    background: rgba(180,79,255,.15); border-color: rgba(180,79,255,.6);
    box-shadow: 0 0 20px rgba(180,79,255,.15);
  }
  .fleet-btn-solid {
    flex: 1; padding: .7rem 1.2rem; border: none; border-radius: 3px;
    background: linear-gradient(135deg, var(--cyan) 0%, #7b00cc 100%);
    color: #fff; font-family: var(--font-label); font-size: .62rem;
    font-weight: 700; letter-spacing: .15em; text-transform: uppercase;
    cursor: pointer; position: relative; overflow: hidden;
    box-shadow: 0 8px 28px rgba(180,79,255,.28);
    transition: opacity .2s, transform .1s, box-shadow .2s;
    text-align: center; text-decoration: none; display: flex;
    align-items: center; justify-content: center; gap: .4rem;
  }
  .fleet-btn-solid::after {
    content: ''; position: absolute;
    top: -50%; left: -50%; width: 200%; height: 200%;
    background: linear-gradient(45deg, transparent, rgba(255,255,255,.1), transparent);
    transform: rotate(45deg) translateX(-100%);
    transition: transform .5s;
  }
  .fleet-btn-solid:hover::after { transform: rotate(45deg) translateX(100%); }
  .fleet-btn-solid:hover { opacity: .92; box-shadow: 0 12px 36px rgba(180,79,255,.38); }
  .fleet-btn-solid:active { transform: scale(.97); }
  .fleet-btn-ghost:active { transform: scale(.97); }

  /* Auth notice on buttons */
  .fleet-btn-auth {
    flex: 1; padding: .7rem 1.2rem; border-radius: 3px;
    border: 1px solid rgba(255,255,255,.08);
    background: rgba(255,255,255,.03);
    color: rgba(255,255,255,.3); font-family: var(--font-label); font-size: .6rem;
    font-weight: 700; letter-spacing: .12em; text-transform: uppercase;
    text-align: center; text-decoration: none; display: flex;
    align-items: center; justify-content: center; gap: .35rem;
    transition: background .2s, color .2s;
  }
  .fleet-btn-auth:hover { background: rgba(255,255,255,.06); color: rgba(255,255,255,.5); }

  /* ── HERO CARD (col-span-8) ── */
  .fleet-hero {
    grid-column: span 8;
    min-height: 520px;
  }
  .fleet-hero .fleet-card-img-wrap {
    position: absolute; inset: 0;
  }
  .fleet-hero .fleet-card-body {
    display: flex; align-items: flex-end; justify-content: space-between;
    flex-wrap: wrap; gap: 1.25rem;
  }

  /* ── TALL CARD (col-span-4) ── */
  .fleet-tall {
    grid-column: span 4;
    min-height: 520px;
  }
  .fleet-tall .fleet-card-img-wrap {
    position: absolute; inset: 0;
  }

  /* ── REGULAR CARD (col-span-4) ── */
  .fleet-reg {
    grid-column: span 4;
  }
  .fleet-reg .fleet-img-wrap {
    height: 240px; overflow: hidden; position: relative;
  }

  /* Parts count strip */
  .fleet-parts-strip {
    display: flex; gap: .4rem; align-items: center;
    font-family: var(--font-label); font-size: .58rem; font-weight: 700;
    letter-spacing: .1em; text-transform: uppercase;
    color: rgba(255,255,255,.3); margin-bottom: .5rem;
  }
  .fleet-parts-strip .material-symbols-outlined { font-size: .8rem; }

  /* ── EMPTY STATE ── */
  .fleet-empty {
    grid-column: 1 / -1;
    padding: 6rem 2rem; text-align: center;
    display: flex; flex-direction: column; align-items: center; gap: 1.25rem;
  }
  .fleet-empty .material-symbols-outlined { font-size: 3rem; color: rgba(180,79,255,.2); }
  .fleet-empty-title { font-family: var(--font-headline); font-size: 1.5rem; color: rgba(255,255,255,.4); text-transform: uppercase; letter-spacing: .04em; }
  .fleet-empty-sub { color: rgba(255,255,255,.2); font-size: .88rem; max-width: 320px; line-height: 1.6; }

  /* ── LOAD MORE ── */
  .fleet-load-more {
    display: flex; align-items: center; justify-content: center; gap: 1.5rem;
    margin-top: 4rem;
    color: rgba(255,255,255,.25);
    font-family: var(--font-label); font-size: .62rem; letter-spacing: .4em; text-transform: uppercase;
  }
  .fleet-load-more-line {
    height: 1px; background: rgba(255,255,255,.08);
    width: 60px; transition: width .3s, background .3s;
  }

  /* Responsive */
  @media (max-width: 900px) {
    .fleet-hero, .fleet-tall, .fleet-reg { grid-column: 1 / -1; }
    .fleet-hero { min-height: 420px; }
    .fleet-tall { min-height: 380px; }
    .fleet-hero .fleet-card-body { flex-direction: column; align-items: flex-start; }
  }
  @media (max-width: 640px) {
    .fleet-shell { padding: 2rem 1rem 4rem; }
    .fleet-actions { flex-direction: column; }
  }
</style>

<div class="fleet-page">
  <div class="fleet-grid-bg"></div>
  <div class="fleet-bloom"></div>

  <div class="fleet-shell">

    <!-- Header -->
    <header class="fleet-header">
      <div class="fleet-eyebrow">
        <div class="fleet-pulse-dot"></div>
        <span class="fleet-eyebrow-label">Live Feed // Deep Space Deployments</span>
      </div>
      <h1 class="fleet-title">Featured Builds</h1>
      <p class="fleet-subtitle">
        Clandestine-grade hardware engineered for precision atmospheric maneuvers.
        Clone any configuration into your forge, or fast-track for immediate deployment.
      </p>
    </header>

    <!-- Bento grid -->
    <div class="fleet-bento">

      <% if (!builds || !builds.length) { %>
        <div class="fleet-empty">
          <span class="material-symbols-outlined">rocket_launch</span>
          <p class="fleet-empty-title">No Active Deployments</p>
          <p class="fleet-empty-sub">The fleet is being assembled. Check back soon or build your own configuration.</p>
          <a href="/build" class="fleet-btn-solid" style="text-decoration:none;padding:.8rem 2rem;flex:unset;">
            <span class="material-symbols-outlined" style="font-size:.9rem;">precision_manufacturing</span>
            Open Builder
          </a>
        </div>

      <% } else { %>

        <%
          const hero  = builds[0];
          const tall  = builds[1] || null;
          const rest  = builds.slice(2);
        %>

        <!-- ── HERO CARD ── -->
        <div class="fleet-card fleet-hero">
          <div style="position:absolute;inset:0;">
            <% if (hero.imageUrl) { %>
              <img src="<%= hero.imageUrl %>" alt="<%= hero.name %>" class="fleet-card-img" />
            <% } else { %>
              <div style="width:100%;height:100%;background:linear-gradient(135deg,rgba(180,79,255,.08),rgba(0,0,0,0));"></div>
            <% } %>
            <div class="fleet-overlay-full"></div>
          </div>
          <% if (hero.purchaseCount > 5) { %><span class="fleet-badge">Top Pick</span><% } %>

          <div class="fleet-card-body">
            <!-- Left: name + specs -->
            <div>
              <span class="fleet-tier">Prototype Grade</span>
              <h2 class="fleet-name fleet-name-lg"><%= hero.name %></h2>
              <% if (hero.specChips && hero.specChips.length) { %>
                <div class="fleet-specs">
                  <% hero.specChips.slice(0,4).forEach(chip => { %>
                    <span class="fleet-spec-chip"><%= chip %></span>
                  <% }) %>
                </div>
              <% } %>
              <div class="fleet-stats">
                <span class="fleet-price">$<%= hero.totalPrice.toFixed(2) %></span>
                <% if (hero.purchaseCount > 0) { %>
                  <span class="fleet-orders">
                    <span class="material-symbols-outlined">local_fire_department</span>
                    <%= hero.purchaseCount %> deployed
                  </span>
                <% } %>
              </div>
            </div>
            <!-- Right: actions -->
            <div class="fleet-actions">
              <% if (user) { %>
                <a href="/builds/<%= hero._id %>/clone" class="fleet-btn-ghost">
                  <span class="material-symbols-outlined" style="font-size:.85rem;">content_copy</span>
                  Clone to Forge
                </a>
                <form action="/builds/<%= hero._id %>/order" method="POST" style="flex:1;display:contents;">
                  <button type="submit" class="fleet-btn-solid">
                    <span class="material-symbols-outlined" style="font-size:.85rem;">bolt</span>
                    Fast-Track Order
                  </button>
                </form>
              <% } else { %>
                <a href="/auth/login" class="fleet-btn-auth">
                  <span class="material-symbols-outlined" style="font-size:.8rem;">lock</span>
                  Sign in to Order
                </a>
              <% } %>
            </div>
          </div>
        </div>

        <!-- ── TALL SIDE CARD ── -->
        <% if (tall) { %>
        <div class="fleet-card fleet-tall">
          <div style="position:absolute;inset:0;">
            <% if (tall.imageUrl) { %>
              <img src="<%= tall.imageUrl %>" alt="<%= tall.name %>" class="fleet-card-img" />
            <% } else { %>
              <div style="width:100%;height:100%;background:linear-gradient(135deg,rgba(180,79,255,.06),transparent);"></div>
            <% } %>
            <div class="fleet-overlay-side"></div>
          </div>

          <div class="fleet-card-body-sm">
            <span class="fleet-tier">Long Range Ops</span>
            <h2 class="fleet-name fleet-name-md"><%= tall.name %></h2>
            <% if (tall.specChips && tall.specChips.length) { %>
              <div class="fleet-specs">
                <% tall.specChips.slice(0,3).forEach(chip => { %>
                  <span class="fleet-spec-chip"><%= chip %></span>
                <% }) %>
              </div>
            <% } %>
            <div class="fleet-stats">
              <span class="fleet-price fleet-price-sm">$<%= tall.totalPrice.toFixed(2) %></span>
              <% if (tall.purchaseCount > 0) { %>
                <span class="fleet-orders">
                  <span class="material-symbols-outlined">local_fire_department</span>
                  <%= tall.purchaseCount %> deployed
                </span>
              <% } %>
            </div>
            <div class="fleet-actions-col">
              <% if (user) { %>
                <a href="/builds/<%= tall._id %>/clone" class="fleet-btn-ghost" style="text-decoration:none;">
                  <span class="material-symbols-outlined" style="font-size:.8rem;">content_copy</span>
                  Clone Config
                </a>
                <form action="/builds/<%= tall._id %>/order" method="POST">
                  <button type="submit" class="fleet-btn-solid" style="width:100%;">
                    <span class="material-symbols-outlined" style="font-size:.8rem;">bolt</span>
                    Quick Buy
                  </button>
                </form>
              <% } else { %>
                <a href="/auth/login" class="fleet-btn-auth" style="text-decoration:none;">
                  <span class="material-symbols-outlined" style="font-size:.8rem;">lock</span>
                  Sign in to Order
                </a>
              <% } %>
            </div>
          </div>
        </div>
        <% } %>

        <!-- ── REGULAR GRID CARDS ── -->
        <% rest.forEach((b, idx) => { %>
          <div class="fleet-card fleet-reg">

            <!-- Image section -->
            <div class="fleet-img-wrap">
              <% if (b.imageUrl) { %>
                <img src="<%= b.imageUrl %>" alt="<%= b.name %>" class="fleet-card-img" style="position:absolute;inset:0;" />
              <% } else { %>
                <div style="width:100%;height:100%;background:linear-gradient(135deg,rgba(180,79,255,.07),transparent);"></div>
              <% } %>
              <div class="fleet-overlay-card"></div>
              <% if (idx === 0 && hero.purchaseCount === 0) { %><span class="fleet-badge">New</span><% } %>
              <% if (b.purchaseCount > 3) { %><span class="fleet-badge">Hot</span><% } %>
            </div>

            <!-- Info section -->
            <div style="padding:1.25rem 1.35rem 1.25rem;">
              <h3 class="fleet-name fleet-name-sm" style="margin-bottom:.4rem;"><%= b.name %></h3>
              <% if (b.description) { %>
                <p style="font-size:.73rem;color:rgba(255,255,255,.3);line-height:1.55;margin-bottom:.75rem;">
                  <%= b.description.length > 90 ? b.description.slice(0,88)+'…' : b.description %>
                </p>
              <% } %>
              <% if (b.specChips && b.specChips.length) { %>
                <div class="fleet-specs" style="margin-bottom:.75rem;">
                  <% b.specChips.slice(0,3).forEach(chip => { %>
                    <span class="fleet-spec-chip"><%= chip %></span>
                  <% }) %>
                </div>
              <% } %>
              <div style="display:flex;align-items:center;justify-content:space-between;gap:.75rem;flex-wrap:wrap;">
                <div>
                  <span class="fleet-price fleet-price-sm">$<%= b.totalPrice.toFixed(2) %></span>
                  <% if (b.purchaseCount > 0) { %>
                    <div style="font-family:var(--font-label);font-size:.52rem;color:rgba(255,138,0,.6);letter-spacing:.08em;text-transform:uppercase;margin-top:.1rem;">
                      🔥 <%= b.purchaseCount %> ordered
                    </div>
                  <% } %>
                </div>
                <div style="display:flex;gap:.45rem;">
                  <% if (user) { %>
                    <a href="/builds/<%= b._id %>/clone"
                       style="padding:.5rem;border:1px solid rgba(255,255,255,.1);border-radius:3px;color:rgba(255,255,255,.3);display:flex;align-items:center;transition:color .2s,border-color .2s;"
                       title="Clone to Builder"
                       onmouseover="this.style.color='var(--cyan)';this.style.borderColor='rgba(180,79,255,.4)';"
                       onmouseout="this.style.color='rgba(255,255,255,.3)';this.style.borderColor='rgba(255,255,255,.1)';">
                      <span class="material-symbols-outlined" style="font-size:.95rem;">edit</span>
                    </a>
                    <form action="/builds/<%= b._id %>/order" method="POST" style="display:inline;">
                      <button type="submit" class="fleet-btn-solid" style="flex:unset;padding:.5rem 1rem;font-size:.58rem;">
                        Order
                      </button>
                    </form>
                  <% } else { %>
                    <a href="/auth/login" class="fleet-btn-auth" style="text-decoration:none;font-size:.58rem;padding:.45rem .9rem;">
                      <span class="material-symbols-outlined" style="font-size:.72rem;">lock</span>
                      Login
                    </a>
                  <% } %>
                </div>
              </div>
            </div>

          </div>
        <% }) %>

      <% } %>
    </div><!-- /fleet-bento -->

    <!-- Load more hint -->
    <% if (builds && builds.length > 0) { %>
    <div class="fleet-load-more">
      <div class="fleet-load-more-line"></div>
      <span>All Configurations Displayed</span>
      <div class="fleet-load-more-line"></div>
    </div>
    <% } %>

  </div><!-- /fleet-shell -->
</div><!-- /fleet-page -->

<%- include('partials/scripts') %>
<%- include('partials/footer') %>
