<%- include('../partials/head', { title: title }) %>
<%- include('../partials/navbar') %>

<main class="admin-page">
  <div class="grid-bg"></div>
  <div class="admin-shell">
    <div class="admin-main">
      <div class="admin-topbar">
        <div>
          <p class="section-label">
            <span class="material-symbols-outlined" style="font-size:.8rem;vertical-align:middle;">manage_accounts</span>
            Operator Management
          </p>
          <h1 class="admin-page-title">User <span style="color:var(--cyan)">Detail</span></h1>
        </div>
        <a href="/admin/users" class="btn btn-outline btn-sm">
          <span class="material-symbols-outlined" style="font-size:.85rem;">arrow_back</span>
          Back to Users
        </a>
      </div>

      <div style="display:grid;grid-template-columns:300px 1fr;gap:1.5rem;align-items:start;">

        <!-- Left: User card -->
        <div style="display:flex;flex-direction:column;gap:1rem;">
          <div class="glass-card" style="padding:2rem;text-align:center;">
            <% if (targetUser.avatarUrl) { %>
              <img src="<%= targetUser.avatarUrl %>" alt="<%= targetUser.name %>" style="width:72px;height:72px;border-radius:50%;object-fit:cover;border:2px solid var(--cyan);margin:0 auto 1rem;display:block;" />
            <% } else { %>
              <div style="width:72px;height:72px;border-radius:50%;background:linear-gradient(135deg,var(--cyan),var(--cyan-dim));display:flex;align-items:center;justify-content:center;margin:0 auto 1rem;font-family:var(--font-headline);font-size:1.75rem;font-weight:900;color:var(--on-cyan);">
                <%= targetUser.name.charAt(0).toUpperCase() %>
              </div>
            <% } %>
            <h2 style="font-family:var(--font-headline);font-size:1.1rem;font-weight:800;color:var(--text);margin-bottom:.25rem;"><%= targetUser.name %></h2>
            <p style="font-size:.8rem;color:var(--muted);font-family:var(--font-mono);margin-bottom:.75rem;"><%= targetUser.email %></p>

            <% if (targetUser.role === 'admin') { %>
              <span style="font-family:var(--font-label);font-size:.65rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--cyan);background:rgba(180,79,255,.12);border:1px solid rgba(180,79,255,.25);border-radius:2rem;padding:.2rem .7rem;display:inline-block;">ADMIN</span>
            <% } else { %>
              <span style="font-family:var(--font-label);font-size:.65rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--text-variant);background:var(--glass-bg);border:1px solid var(--glass-border);border-radius:2rem;padding:.2rem .7rem;display:inline-block;">PILOT</span>
            <% } %>

            <div style="margin-top:1.25rem;padding-top:1.25rem;border-top:1px solid var(--glass-border);text-align:left;display:flex;flex-direction:column;gap:.6rem;">
              <div style="display:flex;justify-content:space-between;align-items:center;">
                <span style="font-size:.75rem;color:var(--muted);font-family:var(--font-label);text-transform:uppercase;letter-spacing:.08em;">Status</span>
                <span class="status-badge <%= targetUser.isActive ? 'status-confirmed' : 'status-cancelled' %>">
                  <%= targetUser.isActive ? 'ACTIVE' : 'INACTIVE' %>
                </span>
              </div>
              <div style="display:flex;justify-content:space-between;align-items:center;">
                <span style="font-size:.75rem;color:var(--muted);font-family:var(--font-label);text-transform:uppercase;letter-spacing:.08em;">Joined</span>
                <span style="font-size:.8rem;color:var(--text-variant);font-family:var(--font-mono);"><%= new Date(targetUser.createdAt).toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'}) %></span>
              </div>
              <% if (targetUser.phone) { %>
              <div style="display:flex;justify-content:space-between;align-items:center;">
                <span style="font-size:.75rem;color:var(--muted);font-family:var(--font-label);text-transform:uppercase;letter-spacing:.08em;">Phone</span>
                <span style="font-size:.8rem;color:var(--text-variant);font-family:var(--font-mono);"><%= targetUser.phone %></span>
              </div>
              <% } %>
            </div>
          </div>

          <!-- Stats -->
          <div class="glass-card" style="padding:1.25rem;display:grid;grid-template-columns:1fr 1fr;gap:1rem;">
            <div style="text-align:center;">
              <div style="font-family:var(--font-mono);font-size:1.75rem;font-weight:900;color:var(--cyan);"><%=  orderCount %></div>
              <div style="font-size:.7rem;color:var(--muted);font-family:var(--font-label);text-transform:uppercase;letter-spacing:.08em;margin-top:.2rem;">Orders</div>
            </div>
            <div style="text-align:center;">
              <div style="font-family:var(--font-mono);font-size:1.75rem;font-weight:900;color:var(--green);">$<%= totalSpent.toFixed(0) %></div>
              <div style="font-size:.7rem;color:var(--muted);font-family:var(--font-label);text-transform:uppercase;letter-spacing:.08em;margin-top:.2rem;">Spent</div>
            </div>
          </div>

          <!-- Bio -->
          <% if (targetUser.bio) { %>
          <div class="glass-card" style="padding:1.25rem;">
            <p style="font-size:.75rem;color:var(--muted);font-family:var(--font-label);text-transform:uppercase;letter-spacing:.08em;margin-bottom:.5rem;">Bio</p>
            <p style="font-size:.85rem;color:var(--text-variant);line-height:1.7;"><%= targetUser.bio %></p>
          </div>
          <% } %>

          <!-- Actions -->
          <% if (targetUser._id.toString() !== currentUserId.toString()) { %>
          <div class="glass-card" style="padding:1.25rem;display:flex;flex-direction:column;gap:.75rem;">
            <button class="btn btn-outline btn-sm toggle-status-btn" data-user-id="<%= targetUser._id %>" data-active="<%= targetUser.isActive %>" style="width:100%;justify-content:center;">
              <span class="material-symbols-outlined" style="font-size:.85rem;"><%= targetUser.isActive ? 'block' : 'check_circle' %></span>
              <%= targetUser.isActive ? 'Deactivate Account' : 'Activate Account' %>
            </button>
          </div>
          <% } %>
        </div>

        <!-- Right: Recent orders -->
        <div class="glass-card admin-card">
          <div class="admin-card-header">
            <h2 class="admin-card-title">Recent Orders</h2>
          </div>
          <% if (recentOrders.length === 0) { %>
            <div style="padding:3rem;text-align:center;color:var(--muted);">
              <span class="material-symbols-outlined" style="font-size:2.5rem;display:block;margin-bottom:.75rem;opacity:.4;">receipt_long</span>
              No orders yet.
            </div>
          <% } else { %>
            <div class="admin-table-wrap">
              <table class="admin-table">
                <thead>
                  <tr>
                    <th>Order ID</th>
                    <th>Build Name</th>
                    <th>Total</th>
                    <th>Status</th>
                    <th>Date</th>
                  </tr>
                </thead>
                <tbody>
                  <% recentOrders.forEach(o => { %>
                    <tr>
                      <td><span style="font-family:var(--font-mono);font-size:.75rem;color:var(--muted);">#<%= o._id.toString().slice(-6).toUpperCase() %></span></td>
                      <td><span style="font-size:.88rem;color:var(--text)"><%= o.buildName || 'Unnamed Build' %></span></td>
                      <td><span style="font-family:var(--font-mono);color:var(--cyan);font-size:.88rem;">$<%= o.totalPrice.toFixed(2) %></span></td>
                      <td><span class="status-badge status-<%= o.status %>"><%= o.status.toUpperCase() %></span></td>
                      <td><span style="font-size:.75rem;color:var(--muted);font-family:var(--font-mono);"><%= new Date(o.createdAt).toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'}) %></span></td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } %>
        </div>
      </div>

    </div>
  </div>
</main>

<div class="toast-container" id="toastContainer"></div>
<%- include('../partials/footer') %>
<%- include('../partials/scripts') %>
<script src="/js/admin.js"></script>

<style>
@media (max-width: 900px) {
  .admin-shell > .admin-main > div[style*="grid-template-columns:300px"] {
    grid-template-columns: 1fr !important;
  }
}
</style>
