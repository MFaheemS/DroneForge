<%
  // Helper: returns 'nav-active' if the current path starts with the given prefix
  function isActive(prefix) {
    if (prefix === '/') return currentPath === '/';
    return currentPath.startsWith(prefix) ? 'nav-active' : '';
  }
%>

<nav class="navbar">
  <a href="/" class="navbar-brand">
    <svg viewBox="0 0 32 32" width="26" height="26" fill="none" xmlns="http://www.w3.org/2000/svg">
      <circle cx="16" cy="16" r="3.5" fill="#00f2ff"/>
      <rect x="4" y="14" width="9" height="4" rx="2" fill="#00f2ff" opacity="0.6"/>
      <rect x="19" y="14" width="9" height="4" rx="2" fill="#00f2ff" opacity="0.6"/>
      <rect x="14" y="4" width="4" height="9" rx="2" fill="#00f2ff" opacity="0.6"/>
      <rect x="14" y="19" width="4" height="9" rx="2" fill="#00f2ff" opacity="0.6"/>
      <circle cx="6" cy="6" r="3" fill="#00f2ff" opacity="0.35"/>
      <circle cx="26" cy="6" r="3" fill="#00f2ff" opacity="0.35"/>
      <circle cx="6" cy="26" r="3" fill="#00f2ff" opacity="0.35"/>
      <circle cx="26" cy="26" r="3" fill="#00f2ff" opacity="0.35"/>
    </svg>
    DRONEFORGE
  </a>

  <button class="hamburger" id="hamburger" aria-label="Toggle menu">
    <span></span><span></span><span></span>
  </button>

  <ul class="navbar-links" id="navLinks">

    <% if (!user) { %>
      <%/* ── Guest navigation ── */%>
      <li><a href="/" class="<%= isActive('/') %>">Home</a></li>
      <li><a href="/builds" class="<%= isActive('/builds') %>">Fleet</a></li>
      <li><a href="/parts" class="<%= isActive('/parts') %>">Marketplace</a></li>
      <li><a href="/auth/login" class="btn-nav <%= isActive('/auth/login') %>">Login</a></li>
      <li><a href="/auth/register" class="btn-nav-solid">Register</a></li>

    <% } else if (user.role === 'admin') { %>
      <%/* ── Admin navigation ── */%>
      <li><a href="/admin" class="<%= isActive('/admin') && currentPath === '/admin' ? 'nav-active' : '' %>">
        <span class="material-symbols-outlined" style="font-size:.9rem;vertical-align:middle;">dashboard</span>
        Dashboard
      </a></li>
      <li><a href="/admin/users" class="<%= isActive('/admin/users') %>">
        <span class="material-symbols-outlined" style="font-size:.9rem;vertical-align:middle;">group</span>
        Users
      </a></li>
      <li><a href="/admin/parts" class="<%= isActive('/admin/parts') %>">
        <span class="material-symbols-outlined" style="font-size:.9rem;vertical-align:middle;">inventory_2</span>
        Parts
      </a></li>
      <li><a href="/admin/orders" class="<%= isActive('/admin/orders') %>">
        <span class="material-symbols-outlined" style="font-size:.9rem;vertical-align:middle;">receipt_long</span>
        Orders
      </a></li>
      <li><a href="/admin/builds" class="<%= isActive('/admin/builds') %>">
        <span class="material-symbols-outlined" style="font-size:.9rem;vertical-align:middle;">rocket_launch</span>
        Builds
      </a></li>

      <%/* Admin user menu */%>
      <li class="dropdown">
        <a href="#" style="gap:0.5rem;">
          <span class="material-symbols-outlined" style="font-size:1rem;font-variation-settings:'FILL' 0;">shield</span>
          <%= user.name.split(' ')[0] %>
          <span class="role-badge admin">ADMIN</span>
        </a>
        <div class="dropdown-menu">
          <a href="/admin/profile">
            <span class="material-symbols-outlined" style="font-size:.9rem;vertical-align:middle;">manage_accounts</span>
            My Profile
          </a>
          <a href="/auth/logout" style="color:var(--error);">
            <span class="material-symbols-outlined" style="font-size:.9rem;vertical-align:middle;">logout</span>
            Logout
          </a>
        </div>
      </li>

    <% } else { %>
      <%/* ── Customer navigation ── */%>
      <li><a href="/" class="<%= isActive('/') %>">Home</a></li>
      <li><a href="/build" class="<%= currentPath === '/build' ? 'nav-active' : '' %>">
        <span class="material-symbols-outlined" style="font-size:.9rem;vertical-align:middle;">precision_manufacturing</span>
        Builder
      </a></li>
      <li><a href="/builds" class="<%= isActive('/builds') %>">
        <span class="material-symbols-outlined" style="font-size:.9rem;vertical-align:middle;">rocket_launch</span>
        Fleet
      </a></li>
      <li><a href="/parts" class="<%= isActive('/parts') %>">Marketplace</a></li>
      <li>
        <a href="/cart" class="<%= isActive('/cart') %>" style="position:relative;">
          <span class="material-symbols-outlined" style="font-size:.95rem;vertical-align:middle;">shopping_cart</span>
          Cart
          <span id="cartNavBadge" style="display:none;position:absolute;top:-6px;right:-10px;min-width:16px;height:16px;background:var(--cyan);color:var(--on-cyan);border-radius:999px;font-size:.55rem;font-weight:700;font-family:var(--font-mono);line-height:16px;text-align:center;padding:0 3px;">0</span>
        </a>
      </li>
      <li><a href="/orders" class="<%= isActive('/orders') %>">Orders</a></li>

      <%/* Customer user menu */%>
      <li class="dropdown">
        <a href="#" style="gap:0.5rem;">
          <span class="material-symbols-outlined" style="font-size:1rem;font-variation-settings:'FILL' 0;">account_circle</span>
          <%= user.name.split(' ')[0] %>
          <span class="role-badge user">PILOT</span>
        </a>
        <div class="dropdown-menu">
          <a href="/profile">
            <span class="material-symbols-outlined" style="font-size:.9rem;vertical-align:middle;">account_circle</span>
            My Profile
          </a>
          <a href="/auth/logout" style="color:var(--error);">
            <span class="material-symbols-outlined" style="font-size:.9rem;vertical-align:middle;">logout</span>
            Logout
          </a>
        </div>
      </li>
    <% } %>

  </ul>
</nav>
