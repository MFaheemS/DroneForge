<%- include('../partials/head', { title: '404 — Signal Lost | DroneForge' }) %>

<div class="error-cinematic-wrap">

  <!-- Cinematic BG -->
  <div class="error-cin-bg" style="background-image:url('https://lh3.googleusercontent.com/aida/ADBb0uiquZ-tThBP5rKXPxqG3GmjujSv_IQqaFkaz_7_UY2hS8kt-UygvWquUMaPd-urKbNkSAaThab1CIDe9_BwBWZ07SYpkvZzrAr6y3RmD-3KBwjxOVh7dqznIRlKwNqZVV8RIQxLpaABC3FGNC0pk34PrxALK6LKSKuxpizgIjmxa3dTEO_5xS4OR_L1UACvlgR5YoboOpnVSBydFq_EWEPPNk9g9vCx6SmvSg5-GDy8iUJ6qoqVruP29II');"></div>
  <div class="error-cin-vignette"></div>
  <div class="scanlines"></div>

  <!-- HUD text overlays -->
  <div class="error-hud error-hud-tl">
    <div>SYS.STAT // OFFLINE</div>
    <div>LAT: --.----</div>
    <div>LNG: --.----</div>
  </div>
  <div class="error-hud error-hud-tr">
    <div>DRONEFORGE CMD</div>
    <div>UPLINK_FAIL</div>
  </div>
  <div class="error-hud error-hud-bl glitch">
    <span class="material-symbols-outlined" style="font-size:.85rem;vertical-align:middle;">warning</span>
    ERR_404_NOT_FOUND
  </div>
  <div class="error-hud error-hud-br">ALT: 0000 MSL</div>

  <!-- Crosshair -->
  <div class="error-crosshair" aria-hidden="true">
    <div class="error-crosshair-ring">
      <div class="ecr-h"></div>
      <div class="ecr-v"></div>
    </div>
  </div>

  <!-- Main panel -->
  <main class="error-cin-panel">
    <div class="error-icon-ring">
      <span class="material-symbols-outlined">sensors_off</span>
      <svg viewBox="0 0 100 100" fill="none">
        <circle cx="50" cy="50" r="48" stroke="currentColor" stroke-dasharray="10 5" stroke-width="1"/>
      </svg>
    </div>

    <h1 class="error-cin-title">Signal Lost</h1>
    <p class="error-cin-sub">
      Telemetry connection severed. The requested vector does not exist in the current airspace. The drone is holding position autonomously in dark territory.
    </p>

    <div style="display:flex;gap:1rem;justify-content:center;flex-wrap:wrap;">
      <a href="/" class="error-cin-btn">
        <span class="material-symbols-outlined" style="font-size:1rem;">flight_takeoff</span>
        Return to Hangar
      </a>
      <a href="/parts" class="btn btn-outline btn-sm">Browse Parts</a>
    </div>

    <p style="font-family:var(--font-mono);font-size:.62rem;color:var(--muted);margin-top:2rem;opacity:.4;letter-spacing:.06em;">
      ERR_ROUTE_NOT_FOUND @ <%= new Date().toISOString() %>
    </p>
  </main>

</div>

<%- include('../partials/scripts') %>
