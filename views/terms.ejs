<%- include('partials/head', { title: 'Terms of Service — DroneForge' }) %>
<%- include('partials/navbar') %>

<main style="min-height:100vh;padding:6rem 0 4rem;">
  <div class="grid-bg"></div>
  <div class="container" style="max-width:780px;position:relative;z-index:1;">

    <div style="text-align:center;margin-bottom:3rem;">
      <p class="section-label" style="justify-content:center;">Legal</p>
      <h1 class="section-title">Terms of <span style="color:var(--cyan);">Service</span>
        <span class="cyan-bar" style="margin:0 auto;"></span>
      </h1>
      <p style="color:var(--muted);font-size:.85rem;margin-top:.75rem;">Last updated: January 2026</p>
    </div>

    <% const sections = [
      { title: '1. Acceptance of Terms', body: 'By accessing or using the DroneForge platform, you agree to be bound by these Terms of Service. If you do not agree, please do not use the platform.' },
      { title: '2. Account Registration', body: 'You must provide accurate information when registering. You are responsible for maintaining the confidentiality of your account credentials and for all activities that occur under your account.' },
      { title: '3. Purchases & Payments', body: 'All prices are listed in USD. Orders are subject to availability. DroneForge reserves the right to cancel or refuse any order. Payment is due at the time of purchase.' },
      { title: '4. Returns & Refunds', body: 'Unused parts in original packaging may be returned within 30 days. Opened electronic components are eligible for exchange only if defective. Shipping costs for returns are the responsibility of the buyer unless the return is due to our error.' },
      { title: '5. Intellectual Property', body: 'All content on DroneForge — including designs, logos, product descriptions, and code — is the property of DroneForge Aerospace. Unauthorized reproduction or distribution is prohibited.' },
      { title: '6. User Conduct', body: 'You agree not to use the platform for any unlawful purpose, to interfere with the operation of the platform, or to attempt unauthorized access to any system or data.' },
      { title: '7. Limitation of Liability', body: 'DroneForge is not liable for any indirect, incidental, or consequential damages arising from your use of the platform or products purchased. Our total liability shall not exceed the amount paid for the relevant order.' },
      { title: '8. Governing Law', body: 'These terms are governed by the laws of the jurisdiction in which DroneForge Aerospace is registered. Any disputes shall be resolved through binding arbitration.' },
      { title: '9. Changes to Terms', body: 'We may update these terms at any time. Continued use of the platform after changes constitutes your acceptance of the new terms. We will notify registered users of significant changes by email.' }
    ]; %>

    <div style="display:flex;flex-direction:column;gap:1.5rem;">
      <% sections.forEach(s => { %>
        <div style="background:var(--glass-bg);border:1px solid var(--glass-border);border-radius:var(--radius-lg);padding:1.5rem;backdrop-filter:var(--glass-blur);">
          <h2 style="font-family:var(--font-headline);font-size:1rem;font-weight:700;color:var(--cyan);margin-bottom:.6rem;"><%= s.title %></h2>
          <p style="color:var(--text-variant);font-size:.9rem;line-height:1.75;"><%= s.body %></p>
        </div>
      <% }) %>
    </div>

    <p style="text-align:center;color:var(--muted);font-size:.8rem;margin-top:2.5rem;">
      Questions? <a href="/contact" style="color:var(--cyan);">Contact us</a>
    </p>
  </div>
</main>

<%- include('partials/footer') %>
<%- include('partials/scripts') %>
